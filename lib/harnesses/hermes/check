#!/bin/sh
# Is this version's Hermes whole? Its checkout is in the harnesses volume, but its runtime -- the
# pinned Python and the dependency environments -- is under ~/.hermes/tools and ~/.hermes/installs,
# in the home, and `hermes backup` leaves it out. So a home restored from backup, or a harnesses
# volume kept while the home was replaced, has a checkout whose launcher points at an interpreter
# that is not there. Failing here makes harness-install reinstall the version, which rebuilds the
# runtime, rather than let every program launch into a half-installed Hermes.
launcher="${1:-${HARNESS_PREFIX}}/src/.hermes/bin/hermes"
[ -f "${launcher}" ] || exit 1
python="$(sed -n '2s/^exec \([^ ]*\) .*/\1/p' "${launcher}")"
[ -n "${python}" ] && [ -x "${python}" ]
