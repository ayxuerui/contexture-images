#!/usr/bin/env python3
"""Write ~/.hermes as a `hermes backup` archive into the directory given, and check it.

The checks are harness-backup.sh's: a locked SQLite source makes `hermes backup` skip the file and
still exit 0, so an archive is only accepted with config.yaml and a state.db that is a real,
non-zeroed SQLite database.
"""
import os
from pathlib import Path
import subprocess
import sys
import zipfile

target = Path(sys.argv[1])
target.mkdir(parents=True, exist_ok=True)
archive = target / 'hermes.zip'
home = Path(os.environ['HOME']) / '.hermes'
if not (home / 'state.db').exists():
    print('hermes: no state.db yet, nothing to snapshot')
    sys.exit(0)
subprocess.run(['hermes', 'backup', '-o', str(archive)], check=True,
               env=dict(os.environ, HERMES_HOME=str(home)))
with zipfile.ZipFile(archive) as zf:
    names = set(zf.namelist())
    missing = [n for n in ('config.yaml', 'state.db') if n not in names]
    if missing:
        sys.exit('hermes: archive is missing ' + ', '.join(missing) + ' (a locked database is skipped silently)')
    if zf.getinfo('state.db').file_size == 0:
        sys.exit('hermes: state.db in the archive is empty')
    with zf.open('state.db') as fh:
        head = fh.read(100)
    if not head.startswith(b'SQLite format 3\x00') or head == b'\x00' * len(head):
        sys.exit('hermes: state.db in the archive is not a valid SQLite database')
    print(f'hermes: archive ok, state.db {zf.getinfo("state.db").file_size} bytes, {len(names)} members')
