#!/bin/sh
set -eu
: "${HARNESS_PREFIX:?HARNESS_PREFIX is required}"
: "${HARNESS_VERSION:?HARNESS_VERSION is required}"
export HERMES_HOME="${HOME}/.hermes"
current="$(dirname "${HARNESS_PREFIX}")/current"

# A restore point before a new version migrates the state, taken by the version running now. A
# backup that fails stops the install: an upgrade without a way back is not taken.
# Only a whole current version can take it: one whose runtime is missing (see `check`) cannot run
# `hermes backup`, and is being reinstalled, not upgraded.
if [ -x "${current}/bin/hermes" ] && [ -f "${HERMES_HOME}/state.db" ] && "$(dirname "$0")/check" "$(readlink -f "${current}")"; then
  points="${HOME}/.local/state/contexture/hermes-pre-update"
  mkdir -p "${points}"
  echo "hermes: backing up ~/.hermes before installing ${HARNESS_VERSION}"
  "${current}/bin/hermes" backup -o "${points}/before-${HARNESS_VERSION}.zip"
  # Two restore points are enough: this one, and the one before it.
  ls -1t "${points}"/before-*.zip 2>/dev/null | tail -n +3 | while read -r old; do rm -f "${old}"; done
fi

installer="$(mktemp)"
trap 'rm -f "${installer}"' EXIT
"$(dirname "$0")/../_lib/fetch-installer" https://hermes-agent.nousresearch.com/install.sh "${installer}"
mkdir -p "${HARNESS_PREFIX}/home" "${HARNESS_PREFIX}/bin"
HOME="${HARNESS_PREFIX}/home" bash "${installer}" --dir "${HARNESS_PREFIX}/src" \
  --commit "v${HARNESS_VERSION}" --non-interactive --skip-computer-use
ln -s ../home/.local/bin/hermes "${HARNESS_PREFIX}/bin/hermes"
