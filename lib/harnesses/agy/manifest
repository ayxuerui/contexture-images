#!/bin/sh
# Print one field (version, url or sha512) of agy's release manifest for this architecture.
set -eu
case "$(dpkg --print-architecture)" in
  amd64) platform=linux_amd64 ;;
  arm64) platform=linux_arm64 ;;
  *) echo "agy: no build for $(dpkg --print-architecture)" >&2; exit 1 ;;
esac
curl -fsSL --retry 3 "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/${platform}.json" \
  | python3 -c 'import json, sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"
