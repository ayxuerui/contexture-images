#!/bin/sh
set -eu
: "${HARNESS_PREFIX:?HARNESS_PREFIX is required}"
here="$(dirname "$0")"
url="$("${here}/manifest" url)"
sha512="$("${here}/manifest" sha512)"
work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
curl -fsSL --retry 3 -o "${work}/agy.tar.gz" "${url}"
printf '%s  %s\n' "${sha512}" "${work}/agy.tar.gz" | sha512sum -c - >/dev/null \
  || { echo "agy: download does not match the manifest's sha512" >&2; exit 1; }
tar -xzf "${work}/agy.tar.gz" -C "${work}"
binary="$(find "${work}" -type f -name antigravity -perm -u+x | head -1)"
[ -n "${binary}" ] || { echo "agy: no antigravity binary in ${url}" >&2; exit 1; }
mkdir -p "${HARNESS_PREFIX}/bin"
install -m 0755 "${binary}" "${HARNESS_PREFIX}/bin/agy"
