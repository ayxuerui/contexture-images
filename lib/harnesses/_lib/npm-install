#!/bin/sh
# Install an npm-published harness into its own prefix, with the platform's Node.
#
# `npm install -g --prefix` puts the package under $HARNESS_PREFIX/lib/node_modules and its bins
# in $HARNESS_PREFIX/bin, which is the layout harness-install expects. The cache goes inside the
# prefix and is deleted afterwards: npm's default is ~/.npm, which is the home volume, and the
# home is what harness-backup snapshots.
#
# Package install scripts do not run: npm 11 (Node 24's) skips them unless allowed, and that is
# kept, so no package code runs at install time. Checked for what is installed today: agent-browser's
# postinstall only downloads a native binary its package already ships, and cb's prints a greeting.
# A harness that truly needs its script names it here with --allow-scripts=<package>.
set -eu
[ "$#" -eq 1 ] || { echo "npm-install: usage: npm-install PACKAGE" >&2; exit 2; }
: "${HARNESS_PREFIX:?HARNESS_PREFIX is required}"
: "${HARNESS_VERSION:?HARNESS_VERSION is required}"
export npm_config_cache="${HARNESS_PREFIX}/.npm-cache"
export npm_config_update_notifier=false npm_config_fund=false npm_config_audit=false
npm install -g --prefix "${HARNESS_PREFIX}" --loglevel=error "$1@${HARNESS_VERSION}"
rm -rf "${npm_config_cache}"
