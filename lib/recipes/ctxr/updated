#!/bin/sh
# A new ctxr is in use: bring the store along (re-render, migrate if its schema is behind), as the
# container start does. ctxr-update-store elects one container per store, opens a pull request when
# anything changed, and never fails: its own output says what it did. Skipped where store updates
# are off -- in serve, which leaves the store's own changes to the agents.
case "${CTXR_UPDATE_STORE_ENABLED:-1}" in
  0|false|FALSE|False|no|NO|No|off|OFF|Off) exit 0 ;;
esac
ctxr-update-store || echo "ctxr: ctxr-update-store exited $?"
